#!/usr/bin/env sh
set -e
# Maven Wrapper script (POSIX) generated by Antigravity
# It will download Maven if not present and delegate calls.

# Determine directory of this script
BASEDIR=$(cd "$(dirname "$0")" && pwd)

# Wrapper version and distribution URL
WRAPPER_JAR="$BASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$BASEDIR/.mvn/wrapper/maven-wrapper.properties"

# If wrapper jar missing, download it
echo "Checking Maven wrapper..."
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven wrapper..."
  mkdir -p "$BASEDIR/.mvn/wrapper"
  curl -L -o "$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/io/takari/maven-wrapper/0.5.6/maven-wrapper-0.5.6.jar"
fi

# Run Maven via the wrapper
java -jar "$WRAPPER_JAR" "$@"
