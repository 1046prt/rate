# Normalize line endings: shell scripts MUST stay LF (they run inside Linux
# containers where CRLF breaks `sh`), everything else follows the repo default.
* text=auto

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
