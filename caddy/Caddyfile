# TLS termination at the edge (recommended production pattern).
# For a real domain, set TLS_DOMAIN (e.g. TLS_DOMAIN=api.example.com) and remove
# `tls internal` so Caddy obtains a Let's Encrypt certificate automatically.
# Without a domain, Caddy serves localhost with an internally-issued certificate.
#
# Load balancing: when the app is scaled (`--scale app=2`), Caddy round-robins
# between the two upstream entries; Docker's embedded DNS rotates the A records
# of `app`, so each dial spreads across replicas. If a replica dies, Caddy fails
# over to the surviving one. Remove the duplicate `to` line for a single instance.
{$TLS_DOMAIN:localhost} {
	tls internal
	reverse_proxy {
		to app:8080 app:8080
		lb_policy round_robin
	}
}
