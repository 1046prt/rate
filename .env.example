# Copy this file to `.env` and adjust values before `docker compose up`.
# The app container fails to start if RATELIMITER_API_KEY is not set.
#
# Generate a strong key, e.g.:
#   openssl rand -hex 32
RATELIMITER_API_KEY=change-me-to-a-random-value

# Optional Redis AUTH password. When set, Redis starts with --requirepass and the
# app authenticates with it. Leave empty for no password (default).
REDIS_PASSWORD=

# TLS keystore password for the prod profile. REQUIRED - the app refuses to
# start without it. Inject from a secret store, never from the repo.
KEYSTORE_PASSWORD=
