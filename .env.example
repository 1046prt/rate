# Copy this file to `.env` and adjust values before `docker compose up`.
# The app container fails to start if RATELIMITER_API_KEY is not set.
#
# Generate a strong key, e.g.:
#   openssl rand -hex 32
RATELIMITER_API_KEY=change-me-to-a-random-value

# Optional Redis AUTH password. When set, Redis starts with --requirepass and the
# app authenticates with it. Leave empty for no password (default).
REDIS_PASSWORD=

# Redis backup sidecar (docker-compose.redis-ha.yml): keep this many daily
# archives in ./backups (default 7). Backups are BGSAVE + tar of the redis-data
# volume; restore procedure in RUNBOOK.md.
BACKUP_KEEP=7

# TLS keystore password for the prod profile. REQUIRED - the app refuses to
# start without it. Inject from a secret store, never from the repo.
KEYSTORE_PASSWORD=

# Observability stack (docker-compose.monitoring.yml):
# Alertmanager receiver webhook URL; rendered into its config at container start.
RECEIVER_URL=http://placeholder-receiver:8080/hooks
# Grafana admin credentials. REQUIRED - compose refuses to start without them
# (no admin/admin default; same fail-closed pattern as the API key).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-random-value
